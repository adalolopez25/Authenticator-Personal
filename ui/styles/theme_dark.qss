/* Authenticator — tema oscuro violeta (archivo propio, UNICO lugar de colores).
   Base global oscura: ningun viewport, fila o tooltip puede quedar blanco. */
QWidget {
  background-color: #1E1E1E;
  color: #FFFFFF;
  font-family: "Segoe UI";
  font-size: 14px;
}
QMainWindow, QWidget#root, QDialog {
  background-color: #1E1E1E;
  color: #FFFFFF;
}
QWidget#sidebar { background-color: #2A2138; }
QWidget#sidebar QLabel { background-color: transparent; }
QWidget#card, QFrame#card {
  background-color: #2C2C2E;
  border: 1px solid #3A3A3C;
  border-radius: 12px;
}
QWidget#row {
  background-color: #2E2E32;
  border: 1px solid #45454A;
  border-radius: 14px;
}
QWidget#row:hover { background-color: #34343C; border: 1px solid #7A63D6; }
QWidget#row QLabel { background-color: transparent; }
QWidget#row QProgressBar { background-color: transparent; }
QLabel { color: #FFFFFF; background-color: transparent; }
QLabel#muted, QLabel#label { color: #A9A9B0; }
QLabel#issuer { color: #B8A6E0; font-size: 13px; }
QLabel#code {
  color: #FFFFFF;
  font-family: "Consolas";
  font-size: 26px;
  letter-spacing: 4px;
}
QLabel#toast {
  background-color: #33264D;
  border: 1px solid #7A63D6;
  border-radius: 8px;
  padding: 8px 12px;
  color: #FFFFFF;
}
QLineEdit, QTextEdit, QComboBox, QSpinBox {
  background-color: #2C2C2E;
  border: 1px solid #45454A;
  border-radius: 8px;
  padding: 8px 12px;
  color: #FFFFFF;
  selection-background-color: #1A7CFF;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
  border: 2px solid #1A7CFF;
}
QLineEdit#search { border-radius: 16px; }
/* Subcontroles compactos: sin flechas gigantes (ver captura Añadir). */
QSpinBox::up-button, QSpinBox::down-button {
  width: 26px;
  border: none;
  border-left: 1px solid #45454A;
  background-color: transparent;
  subcontrol-origin: border;
}
QSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 8px; }
QSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 8px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #33264D; }
QSpinBox::up-arrow, QSpinBox::down-arrow { width: 10px; height: 10px; }
QComboBox::drop-down {
  width: 30px;
  border: none;
  border-left: 1px solid #45454A;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
}
QComboBox::drop-down:hover { background-color: #33264D; }
QComboBox::down-arrow { width: 10px; height: 10px; }
QComboBox QAbstractItemView {
  background-color: #2C2C2E;
  color: #FFFFFF;
  selection-background-color: #1A7CFF;
  border: 1px solid #45454A;
  outline: none;
}
QPushButton {
  background-color: #2C2C2E;
  border: 1px solid #3A3A3C;
  border-radius: 8px;
  padding: 8px 14px;
  color: #FFFFFF;
}
QPushButton:hover { border: 1px solid #7A63D6; }
QPushButton#primary {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7A63D6, stop:1 #5F4BB0);
  color: #FFFFFF;
  border: none;
  border-radius: 10px;
  padding: 11px 16px;
  font-weight: 600;
  font-size: 15px;
}
QPushButton#primary:hover { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8A72E0, stop:1 #6A58C4); }
QPushButton#primary:pressed { background-color: #5F4BB0; }
QPushButton#primary:disabled { background-color: #3A3A3C; color: #A9A9B0; }
QPushButton#ghost {
  background-color: transparent;
  border: 1px solid #3A3A3C;
  border-radius: 8px;
  padding: 8px 12px;
  color: #FFFFFF;
}
QPushButton#ghost:hover { border: 1px solid #7A63D6; }
QPushButton#danger {
  background-color: transparent;
  border: 1px solid #FF6B6B;
  border-radius: 8px;
  padding: 8px 12px;
  color: #FF6B6B;
}
QPushButton#toolBtn {
  background-color: transparent;
  border: none;
  color: #A9A9B0;
  padding: 4px 8px;
}
QPushButton#toolBtn:hover { color: #FFFFFF; }
QProgressBar#count {
  background-color: #3A3A3C;
  border: none;
  border-radius: 3px;
  height: 6px;
  text-align: center;
}
QProgressBar#count::chunk { background-color: #7A63D6; border-radius: 3px; }
QProgressBar#count[urgent="true"]::chunk { background-color: #FF6B6B; }
QScrollArea, QScrollArea QWidget, QAbstractScrollArea, QAbstractScrollArea QWidget {
  background-color: #1E1E1E;
  border: none;
}
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #3A3A3C; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #7A63D6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
/* La app no necesita scroll horizontal en ningun panel: evita barras fantasma. */
QScrollBar:horizontal { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QLabel#remain {
  color: #B8A6E0;
  font-family: "Consolas";
  font-size: 13px;
  font-weight: 700;
}
QLabel#remain[urgent="true"] { color: #FF6B6B; }
QWidget#previewCard {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #33264D, stop:1 #2A2138);
  border: 1px solid #7A63D6;
  border-radius: 14px;
}
QLabel#previewCode {
  color: #FFFFFF;
  font-family: "Consolas";
  font-size: 30px;
  letter-spacing: 5px;
}
QLabel#authIcon {
  background-color: #33264D;
  border: 1px solid #7A63D6;
  border-radius: 32px;
}
/* Checkboxes estilizados (nada de cuadros Fusion por defecto). */
QCheckBox { color: #FFFFFF; spacing: 10px; background-color: transparent; font-size: 14px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 6px;
  border: 1px solid #4A4A52; background-color: #2C2C2E; }
QCheckBox::indicator:hover { border: 1px solid #7A63D6; }
QCheckBox::indicator:checked { background-color: #7A63D6; border: 1px solid #7A63D6; }
QCheckBox::indicator:disabled { background-color: #3A3A3C; border: 1px solid #3A3A3C; }
/* InfoBox: aviso con acento lateral por tono. */
QWidget#infoBox { background-color: #2C2C2E; border: 1px solid #3A3A3C;
  border-left: 3px solid #7A63D6; border-radius: 10px; }
QWidget#infoBox[tone="warn"] { border-left: 3px solid #FFD60A; }
QWidget#infoBox[tone="danger"] { border-left: 3px solid #FF6B6B; }
QWidget#infoBox[tone="ok"] { border-left: 3px solid #30D158; }
QWidget#infoBox QLabel { background-color: transparent; }
/* Stat tiles (Preferencias > General). */
QWidget#statTile { background-color: #2C2C2E; border: 1px solid #3A3A3C; border-radius: 12px; }
QLabel#statNum { font-size: 26px; font-weight: 700; color: #FFFFFF; background-color: transparent; }
QPushButton:focus { outline: none; border: 2px solid #1A7CFF; }
QPushButton#sideBtn:focus, QPushButton#toolBtn:focus, QPushButton#iconBtn:focus { border: 1px solid #7A63D6; }
QMenu {
  background-color: #2C2C2E;
  border: 1px solid #3A3A3C;
  border-radius: 8px;
  padding: 4px;
}
QMenu::item { padding: 8px 20px; border-radius: 6px; }
QMenu::item:selected { background-color: #33264D; }
QToolTip {
  background-color: #33264D;
  color: #FFFFFF;
  border: 1px solid #7A63D6;
  padding: 4px 8px;
}
/* Sidebar escritorio */
QLabel#brand {
  color: #FFFFFF;
  font-size: 17px;
  font-weight: 700;
  padding: 4px 8px;
}
QPushButton#sideBtn {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 9px;
  padding: 10px 12px;
  color: #A9A9B0;
  font-size: 14px;
  text-align: left;
}
QPushButton#sideBtn:hover {
  background-color: #33264D;
  color: #FFFFFF;
  border: 1px solid transparent;
}
QPushButton#sideBtn:checked {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3A2F5E, stop:1 #2E2450);
  border: 1px solid #7A63D6;
  color: #FFFFFF;
  font-weight: 600;
}
QLabel#badge {
  background-color: #7A63D6;
  color: #FFFFFF;
  border-radius: 9px;
  padding: 2px 8px;
  font-size: 12px;
  font-weight: 700;
}
QLabel#navCap {
  color: #A9A9B0;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 10px;
}
QLabel#avatar {
  background-color: #3A2F5E;
  border: 1px solid #7A63D6;
  border-radius: 23px;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 700;
}
/* Monograma de mosaico: 12 colores fijos por emisor (propiedad `c`). */
QLabel#tileMono { border-radius: 18px; color: #FFFFFF; font-size: 30px; font-weight: 700; }
QLabel#tileMono[c="0"] { background-color: #5F4BB0; }
QLabel#tileMono[c="1"] { background-color: #2F6F5E; }
QLabel#tileMono[c="2"] { background-color: #8A5A2B; }
QLabel#tileMono[c="3"] { background-color: #A03A4B; }
QLabel#tileMono[c="4"] { background-color: #2B5F8A; }
QLabel#tileMono[c="5"] { background-color: #6B3A7A; }
QLabel#tileMono[c="6"] { background-color: #3A7A3A; }
QLabel#tileMono[c="7"] { background-color: #8A8A2B; }
QLabel#tileMono[c="8"] { background-color: #4B6BB0; }
QLabel#tileMono[c="9"] { background-color: #B06B4B; }
QLabel#tileMono[c="10"] { background-color: #4B9A8A; }
QLabel#tileMono[c="11"] { background-color: #7A4B5E; }
QWidget#tile {
  background-color: #2E2E32;
  border: 1px solid #45454A;
  border-radius: 16px;
}
QWidget#tile:hover { border: 1px solid #7A63D6; background-color: #34343C; }
QWidget#tile QLabel { background-color: transparent; }
QLabel#tileName { color: #FFFFFF; font-size: 15px; font-weight: 700; }
QLabel#tileSub { color: #A9A9B0; font-size: 12px; }
QLabel#modalCode {
  color: #FFFFFF;
  font-family: "Consolas";
  font-size: 44px;
  letter-spacing: 6px;
}
QLabel#emptyArt {
  color: #3A3A3C;
  font-size: 56px;
}
QPushButton#iconBtn {
  background-color: transparent;
  border: 1px solid #3A3A3C;
  border-radius: 8px;
  padding: 4px;
  color: #B8A6E0;
}
QPushButton#iconBtn:hover { border: 1px solid #7A63D6; color: #FFFFFF; }
/* Sub-nav de Preferencias */
QListWidget#prefNav {
  background-color: #2A2138;
  border: 1px solid #3A3A3C;
  border-radius: 12px;
  padding: 6px;
  outline: none;
}
QListWidget#prefNav::item {
  border-radius: 8px;
  padding: 10px 12px;
  color: #A9A9B0;
}
QListWidget#prefNav::item:hover { background-color: #33264D; color: #FFFFFF; }
QListWidget#prefNav::item:selected { background-color: #3A2F5E; color: #FFFFFF; font-weight: 600; }
